# RaKeGa — every variable the apps read. Real values go in backend/.env (never committed).
# Nothing secret ever gets a VITE_ prefix. Every service below is optional until launch:
# empty values switch that seam to its local or simulated implementation ($0).

# backend
PORT=4111
DATABASE_URL=postgresql://rakega:rakega@localhost:5432/rakega
SESSION_SECRET=               # 32+ random characters
APP_URL=http://localhost:5111

# models (free-first; leave empty to use the labelled simulator)
GEMINI_API_KEY=
GROQ_API_KEY=
AI_BUDGET_USD_PER_RUN=0.05

# live rooms (Live) — local dev server: LIVEKIT_URL=ws://localhost:7880 with its dev key/secret
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# recorded video (Learn) — VIDEO_HOST=local (dev, $0) | r2 (launch, free tier) | bunny (growth)
VIDEO_HOST=local
VIDEO_LOCAL_DIR=./storage/video
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_TOKEN_AUTH_KEY=         # signs playback URLs so links can't be shared

# payments — Razorpay (test keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# delivery records to the reviewer (Works) — Telegram bot (free); create it with @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_REVIEWER_CHAT_ID=

# outreach (Reach agent) — your own domain's mailbox, with SPF/DKIM/DMARC set up
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
OUTREACH_DAILY_CAP=20

# frontend (public, non-secret)
VITE_API_URL=http://localhost:4111
