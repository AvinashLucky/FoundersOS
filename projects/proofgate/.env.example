# ─────────────────────────────────────────────────────────────────────────────
# Environment for this project. Copy to backend/.env (and the frontend variable to
# frontend/.env). Never commit .env files. Nothing secret goes in a frontend variable —
# frontend variables are bundled into the app and visible to anyone.
# ─────────────────────────────────────────────────────────────────────────────

# ══ BACKEND ══════════════════════════════════════════════════════════════════

# PostgreSQL connection string (local, Docker, or a hosted free tier).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# API port. Matches project.json → apps.backend.port.
PORT=4110

# The frontend origin allowed to call this API (CORS).
CORS_ORIGIN=http://localhost:5110

# Gemini — the primary model. Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=

# Free OpenAI-compatible tiers — set any you have; unset ones are never registered.
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# XAI_API_KEY=

# Hard cap on model spend per workflow run (USD). The run stops and reports when hit.
AI_BUDGET_USD_PER_RUN=0.05

# ══ FRONTEND ═════════════════════════════════════════════════════════════════

# Where the frontend finds the API.
VITE_API_URL=http://localhost:4110
