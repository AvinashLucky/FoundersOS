# FounderOS monorepo — root env contract (copy to .env.local; never commit secrets)
# Providers (BYO; routed via Model Router)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
LOCAL_MODEL_URL=http://localhost:11434
# Data (hybrid)
MONGODB_URI=mongodb://localhost:27017/founderos
DATABASE_URL=postgresql://user:pass@localhost:5432/founderos
REDIS_URL=redis://localhost:6379
# Storage
STORAGE_ENDPOINT=
STORAGE_BUCKET=founderos
STORAGE_ACCESS_KEY=
STORAGE_SECRET=
# Auth
AUTH_SECRET=
KEY_VAULT_URL=
# App / ops
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info
