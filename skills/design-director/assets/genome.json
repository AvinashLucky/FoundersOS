{
  "version": 1,
  "about": "The design vocabulary for design-director. Every axis is public, generic design language — no option reproduces a specific company's template. Weights below 1 down-rank overused AI defaults; they stay available when chosen deliberately.",
  "weights": {
    "layout": 3,
    "color": 3,
    "type": 2,
    "imagery": 2,
    "hero": 2,
    "signature": 2,
    "nav": 1,
    "shape": 1,
    "density": 1,
    "motion": 1,
    "surface": 1
  },
  "axes": {
    "layout": [
      {
        "id": "editorial-column",
        "note": "One strong reading column, generous margins, pull quotes. Long-form, trust, storytelling."
      },
      {
        "id": "swiss-grid",
        "note": "Strict 12-column grid, flush-left type, visible alignment. Institutions, finance, design-literate brands."
      },
      {
        "id": "asymmetric-split",
        "note": "Unequal two-column compositions that alternate. Product marketing with personality."
      },
      {
        "id": "bento-modular",
        "note": "Mixed-size tiles. Feature overviews — heavily overused, use only when content is genuinely modular.",
        "weight": 0.35
      },
      {
        "id": "full-bleed-cinematic",
        "note": "Edge-to-edge imagery or video per section. Hospitality, launches, premium consumer."
      },
      {
        "id": "card-mosaic",
        "note": "Uniform cards in a responsive grid. Catalogues, directories, listings."
      },
      {
        "id": "long-scroll-narrative",
        "note": "One continuous story with chapters. Launches, mission-led brands."
      },
      {
        "id": "dashboard-forward",
        "note": "The product UI is the page. Analytics, ops tools, fintech."
      },
      {
        "id": "magazine-multicolumn",
        "note": "Mixed column counts like print. Media, publishing, culture."
      },
      {
        "id": "minimal-centered",
        "note": "Centred stack, very few elements. Waitlists, single-purpose tools."
      },
      {
        "id": "sidebar-index",
        "note": "Persistent index or table of contents beside content. Docs, knowledge bases, reports."
      },
      {
        "id": "brutalist-raw",
        "note": "Exposed structure, system fonts or heavy type, hard borders. Studios, culture, dev tools with attitude."
      },
      {
        "id": "stacked-panels",
        "note": "Full-height panels that stack on scroll. Product tours, step-by-step stories."
      },
      {
        "id": "product-led-canvas",
        "note": "Interactive product canvas the visitor can try on the page. Tools, calculators, builders."
      },
      {
        "id": "catalog-grid",
        "note": "Filterable product grid with strong facets. Commerce.",
        "only": [
          "ecommerce",
          "food-delivery",
          "restaurant",
          "real-estate",
          "travel-hospitality"
        ]
      },
      {
        "id": "timeline-story",
        "note": "A visible timeline rail carries the page. Process, history, logistics, healthcare journeys."
      },
      {
        "id": "documentation-shell",
        "note": "Header + sidebar + content + on-page nav. Developer docs, APIs.",
        "only": [
          "devtools",
          "saas-b2b",
          "ai-product"
        ]
      },
      {
        "id": "split-screen-fixed",
        "note": "One half fixed (image or form), the other scrolls. Contact, booking, onboarding."
      }
    ],
