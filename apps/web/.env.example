# FounderOS — environment TEMPLATE. This file is committed: NEVER put real keys here.
# Copy to .env.local (git-ignored) and fill in. Next.js reads .env.local, not this file.
# ─────────────────────────────────────────────────────────────────────────────
# The app runs with ZERO keys (offline Echo engine). Every var below is optional.
# Any key var may hold a comma-separated list: when one key hits its limit the
# next is used, and when a whole provider refuses, the next model is tried.
# ─────────────────────────────────────────────────────────────────────────────

# 1) Google Gemini — keys per role (aistudio.google.com/apikey)
#    WORKER → fast tier · COMPLEX_WORKS → balanced · CEO_COO → frontier (gemini-4-argon when your key can reach it)
GEMINI_API_KEYS_WORKER=
GEMINI_API_KEYS_CEO_COO=
GEMINI_API_KEYS_COMPLEX_WORKS=
# GEMINI_API_KEY=            # single shared key also works

# 2) Groq (console.groq.com/keys) — default model openai/gpt-oss-120b
GROQ_API_KEY=
# GROQ_MODEL=

# 3) Mistral (console.mistral.ai, "Experiment" plan) — default mistral-small-latest
MISTRAL_API_KEY=
# MISTRAL_MODEL=

# 4) GLM via SiliconFlow (cloud.siliconflow.com) — default THUDM/GLM-4-9B-0414
GLM_API_KEY=
# GLM_BASE_URL=https://api.siliconflow.com/v1
# GLM_MODEL=

# 5) OpenRouter (openrouter.ai/keys) — only ":free" model ids are routed, so credit is never spent
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# 6) Tavily web search (app.tavily.com) — one or more keys, rotated
TAVILY_API_KEY=
# TAVILY_API_KEY_TWO=

# ══ LOCAL ENGINE (opt-in — needs a capable PC) ═══════════════════════════════
# OLLAMA_ENABLED=true
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ══ PAID (optional) ═════════════════════════════════════════════════════════
ANTHROPIC_API_KEY=

# ══ APP ═════════════════════════════════════════════════════════════════════
# Any random 32+ character string. Signs your session cookie.
AUTH_SECRET=change-me-to-a-long-random-string-please
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Hard ceiling per company run (USD). The budget governor degrades tiers to obey it.
RUN_BUDGET_USD=0.05

# ══ PERSISTENCE (optional — in-memory when blank) ═══════════════════════════
MONGODB_URI=
MONGODB_DB=founderos
